{
  "extends": "@platform/config/tsconfig/react.json",
  "compilerOptions": {
    "types": ["node"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "next.config.ts",
    "playwright.config.ts",
    ".next/types/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".next"],
  "references": [
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/i18n"
    },
    {
      "path": "../../packages/ui"
    }
  ]
}
