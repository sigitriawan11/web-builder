{
  "name": "web-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9.15 <10"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:api": "dotenv -e .env -- turbo run dev --filter=@platform/api",
    "dev:editor": "dotenv -e .env -- turbo run dev --filter=@platform/editor",
    "dev:web": "dotenv -e .env -- turbo run dev --filter=@platform/web",
    "dev:worker": "dotenv -e .env -- turbo run dev --filter=@platform/worker",
    "build": "dotenv -e .env -- turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "i18n:check": "pnpm --filter @platform/i18n check",
    "format": "biome check --write .",
    "infra:up": "dotenv -e .env -- sh docker/infra.sh up",
    "infra:down": "dotenv -e .env -- sh docker/infra.sh down",
    "test": "dotenv -e .env -- turbo run test",
    "test:perf": "dotenv -e .env -v PERF_ASSERT=1 -- turbo run test --filter=@platform/document-model --filter=@platform/renderer --concurrency=1",
    "test:coverage": "dotenv -e .env -- turbo run test:coverage",
    "test:integration": "dotenv -e .env -- turbo run test:integration",
    "test:e2e": "dotenv -e .env -- turbo run test:e2e",
    "bench": "dotenv -e .env -- turbo run bench",
    "bench:canvas": "pnpm --filter @platform/editor bench:canvas",
    "db:generate": "dotenv -e .env -- turbo run db:generate",
    "db:migrate": "dotenv -e .env -- turbo run db:migrate",
    "db:seed": "dotenv -e .env -- turbo run db:seed --",
    "db:reset": "dotenv -e .env -- turbo run db:reset",
    "db:check": "turbo run db:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@platform/config": "workspace:*",
    "@swc/core": "1.16.18",
    "dependency-cruiser": "18.6.0",
    "dotenv-cli": "11.0.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "pino": "10.3.1",
      "use-intl": "4.14.8",
      "icu-minify": "4.14.8",
      "@opentelemetry/core": "2.11.0",
      "@opentelemetry/resources": "2.11.0",
      "@opentelemetry/sdk-trace-base": "2.11.0",
      "@opentelemetry/sdk-trace": "2.11.0"
    }
  }
}
