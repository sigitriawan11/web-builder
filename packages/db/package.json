{
  "name": "@platform/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json seed/tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:seed": "tsx seed/index.ts",
    "db:reset": "tsx seed/reset.ts",
    "db:check": "sh scripts/check-migrations.sh",
    "db:prepare-e2e": "tsx test/prepare-e2e-db.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@platform/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.4",
    "yjs": "13.6.33"
  },
  "dependencies": {
    "@platform/document-model": "workspace:*",
    "@platform/library-seed": "workspace:*",
    "@platform/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "zod": "4.6.7"
  }
}
