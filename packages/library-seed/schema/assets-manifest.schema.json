{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seedVersion": {
      "type": "number",
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^(ast)_[0-9a-z]{6,24}$"
          },
          "file": {
            "type": "string",
            "pattern": "^images\\/[a-z0-9][a-z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "svg"
            ]
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "attributionRequired": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "assetId",
          "file",
          "kind",
          "license",
          "source",
          "attributionRequired"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "seedVersion",
    "assets"
  ],
  "additionalProperties": false
}
