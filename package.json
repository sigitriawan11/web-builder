{
  "name": "web-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9.15 <10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "bench:canvas": "pnpm --filter @platform/editor bench:canvas",
    "format": "biome check --write .",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@platform/config": "workspace:*",
    "@swc/core": "1.16.18",
    "dependency-cruiser": "18.6.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
