{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Project references (`tsc -b`): composite wajib emit; hanya deklarasi, ke node_modules/.tsc per paket
    // (tidak masuk git, tidak dipakai runtime — paket internal tetap diekspor sebagai source TS).
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "${configDir}/node_modules/.tsc",
    // Tipe global hanya bila diminta (mis. tsconfig/node.json); mencegah @types/node bocor ke paket isomorfik.
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
